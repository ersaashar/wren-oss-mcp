# Production environment — ClickHouse semantic project.
# Copy to .env.prod (ignored by Git) and replace every placeholder.
# WREN_IMAGE must be the exact digest that was tested in staging.
WREN_ENV=prod
WREN_PROFILE=clickhouse-prod
WREN_IMAGE=ghcr.io/ibukansaya/wren-clickhouse@sha256:<64-hex-digest>

# Replace with the production ClickHouse endpoint and least-privileged account.
CH_HOST=clickhouse-prod.internal.example.invalid
CH_PORT=8443
CH_DATABASE=mart_prod
CH_USER=wren_prod_ro
CH_PASSWORD=<prod-password>
