# Staging environment — ClickHouse semantic project.
# Copy to .env.staging (ignored by Git) and replace every placeholder.
WREN_ENV=staging
WREN_PROFILE=clickhouse-staging
WREN_IMAGE=ghcr.io/ibukansaya/wren-clickhouse@sha256:<64-hex-digest>

# Replace with the staging ClickHouse endpoint and least-privileged account.
CH_HOST=clickhouse-staging.internal.example.invalid
CH_PORT=8443
CH_DATABASE=mart_staging
CH_USER=wren_staging_ro
CH_PASSWORD=<staging-password>
